---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/cairo/400.css';
import '@fontsource/cairo/600.css';
import '@fontsource/cairo/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dir, otherLocale, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description = t(locale, 'site.description') } = Astro.props;
const fullTitle = title ? `${title} · ${t(locale, 'site.name')}` : t(locale, 'site.name');

// Every page under /fr/ exists under /ar/ at the same path, and the other way
// round. Pages outside them (the 404) have no translation: switch to the home.
const localized = /^\/(fr|ar)(\/|$)/.test(Astro.url.pathname);
const rest = localized ? Astro.url.pathname.slice(3) || '/' : '/';
const alternate = (l: Locale) => new URL(`/${l}${rest}`, Astro.site).href;
const canonical = alternate(locale);
const other = otherLocale(locale);
---

<!doctype html>
<html lang={locale} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#65cbc4" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {localized && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={locale} href={canonical} />
        <link rel="alternate" hreflang={other} href={alternate(other)} />
        <link rel="alternate" hreflang="x-default" href={alternate('fr')} />
      </>
    )}
    {!localized && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(locale, 'site.name')} />
    <meta property="og:title" content={title ?? t(locale, 'site.name')} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/icon-512.png', Astro.site).href} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_DZ' : 'ar_DZ'} />
  </head>
  <body>
    <Header locale={locale} switchHref={`/${other}${rest}`} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/progress';
    </script>
  </body>
</html>
