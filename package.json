{
  "name": "de9de9-academy",
  "version": "0.1.0",
  "private": true,
  "description": "De9De9 Academy - bilingual (FR/AR) lessons on what De9De9 sells, as a mobile app",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-content.mjs",
    "watch": "node scripts/build-content.mjs --watch",
    "start": "node scripts/build-content.mjs && python3 -m http.server 5174 --directory www",
    "test": "node --test tests/*.test.mjs",
    "sync": "cap sync",
    "ios": "cap sync ios && cap open ios",
    "android": "cap sync android && cap open android",
    "capacitor:copy:before": "node scripts/build-content.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "marked": "^18.1.0",
    "yaml": "^2.9.1"
  }
}
